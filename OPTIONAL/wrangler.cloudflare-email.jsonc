{
  // Ultimate Online game server + Ultimate Team accounts. Deploy: connect this repo in Cloudflare (Workers & Pages -> Create -> Import a repository)
  "name": "football",
  "main": "src/worker.js",
  "send_email": [ { "name": "EMAIL" } ],   // Cloudflare email sending (needs your domain set up for Email Sending in Cloudflare)
  "keep_vars": true,                 // settings you add in the Cloudflare dashboard (EMAIL_REQUIRED, MAIL_FROM...) survive every redeploy
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [ { "name": "ROOMS", "class_name": "Room" }, { "name": "VAULT", "class_name": "Vault" }, { "name": "MATCH", "class_name": "Match" }, { "name": "MM", "class_name": "Matchmaker" }, { "name": "TRADE", "class_name": "Trade" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Vault"] }, { "tag": "v3", "new_sqlite_classes": ["Match", "Matchmaker"] }, { "tag": "v4", "new_sqlite_classes": ["Trade"] } ]
}
